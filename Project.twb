  <worksheets>
    <worksheet name=' YTD Avg Price'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Car Sales Data)' name='federated.1tzxjue1x0e6c617lv6ce1uo5afw' />
          </datasources>
          <datasource-dependencies datasource='federated.1tzxjue1x0e6c617lv6ce1uo5afw'>
            <column datatype='string' name='[Body Style]' role='dimension' type='nominal' />
            <column caption='YTD Total Sales ' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[Calculation_0784277656489984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF&#13;&#10;YEAR([Date]) = {MAX(YEAR([Date]))}&#13;&#10;then&#13;&#10;[Price ($)]&#13;&#10;END)' />
            </column>
            <column caption='YTD Cars Sold' datatype='integer' default-format='c&quot; #&quot;#,##0,.00K;&quot; #&quot;-#,##0,.00K' name='[Calculation_0784277666856963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF&#13;&#10;YEAR([Date]) = {MAX(YEAR([Date]))}&#13;&#10;THEN &#13;&#10;[Car_id]&#13;&#10;END)' />
            </column>
            <column caption='YTD Avg Price ' datatype='real' default-format='c&quot;$&quot;#,##0,.00K' name='[Calculation_0784277733240838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0784277656489984]/ [Calculation_0784277666856963]' />
            </column>
            <column caption='PYTD Avg Price ' datatype='real' name='[Calculation_0784277733441543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[YTD Total Sales  (copy)_0784277658382337] / [YTD Cars Sold (copy)_0784277729816580]' />
            </column>
            <column caption='YOY Avg Growth ' datatype='real' name='[Calculation_0784277735317512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0784277733240838] - [Calculation_0784277733441543] ) / [Calculation_0784277733441543]' />
            </column>
            <column caption='Car id' datatype='string' name='[Car_id]' role='dimension' type='nominal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Engine]' role='dimension' type='nominal' />
